<UserControl
    x:Class="Translumo.Controls.TrayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Translumo.MVVM.Common"
    xmlns:controls="clr-namespace:Translumo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    x:Name="TrayUserControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <system:Boolean x:Key="ConfirmationClose">False</system:Boolean>

        <!-- Minimalist Dark ContextMenu Style -->
        <Style x:Key="ContextMenuDefaultStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Name="Border"
                                Background="#141414"
                                BorderThickness="1"
                                BorderBrush="#2C2C2C"
                                CornerRadius="8"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.6" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Dark MenuItem Style -->
        <Style x:Key="MenuItemDefaultStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial, sans-serif" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="6"
                                Margin="0,1,0,1"
                                Padding="12,0,14,0"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#242424" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#333333" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Separator Style -->
        <Style x:Key="SeparatorDefaultStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,3,4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#242424" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <tb:TaskbarIcon
            Name="TiIcon"
            DataContext="{Binding RelativeSource={RelativeSource AncestorType=controls:TrayControl}}"
            DoubleClickCommand="{Binding SettingsOpeningCommand}"
            IconSource="pack://application:,,,/ocrtranslate;component/Resources/Icons/favicon.ico"
            ToolTipText="{StaticResource ApplicationName}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource ContextMenuDefaultStyle}">
                    <MenuItem
                        x:Name="First"
                        Command="{Binding SettingsOpeningCommand}"
                        Header="{DynamicResource Str.Tray.ShowHideSettings}"
                        Style="{StaticResource MenuItemDefaultStyle}" />
                    <MenuItem
                        Command="{Binding ChatOpeningCommand}"
                        Header="{DynamicResource Str.Tray.ShowHideTranslation}"
                        Style="{StaticResource MenuItemDefaultStyle}" />
                    <Separator Style="{StaticResource SeparatorDefaultStyle}" />
                    <MenuItem
                        Command="{common:CloseAppCommand}"
                        CommandParameter="{StaticResource ConfirmationClose}"
                        Header="{DynamicResource Str.Tray.Exit}"
                        Style="{StaticResource MenuItemDefaultStyle}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</UserControl>
