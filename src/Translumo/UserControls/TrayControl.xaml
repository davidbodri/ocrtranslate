<UserControl
    x:Class="Translumo.Controls.TrayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Translumo.MVVM.Common"
    xmlns:controls="clr-namespace:Translumo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    x:Name="TrayUserControl"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <system:Boolean x:Key="ConfirmationClose">False</system:Boolean>

        <!-- Clean Modern White ContextMenu Style -->
        <Style x:Key="ContextMenuDefaultStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Name="Border"
                                Background="#FFFFFF"
                                BorderThickness="1"
                                BorderBrush="#E5E7EB"
                                CornerRadius="12"
                                Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#28000000" RenderingBias="Performance" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Modern White MenuItem Style -->
        <Style x:Key="MenuItemDefaultStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#18181B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, Arial, sans-serif" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="8"
                                Margin="0,1"
                                Padding="12,0,14,0"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F4F5F7" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Separator Style -->
        <Style x:Key="SeparatorDefaultStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#E5E7EB" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <tb:TaskbarIcon
            Name="TiIcon"
            DataContext="{Binding RelativeSource={RelativeSource AncestorType=controls:TrayControl}}"
            LeftClickCommand="{Binding SettingsOpeningCommand}"
            DoubleClickCommand="{Binding SettingsOpeningCommand}"
            IconSource="pack://application:,,,/ocrtranslate;component/Resources/Icons/favicon.ico"
            ToolTipText="{StaticResource ApplicationName}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource ContextMenuDefaultStyle}">
                    <MenuItem
                        x:Name="First"
                        Command="{Binding SettingsOpeningCommand}"
                        Style="{StaticResource MenuItemDefaultStyle}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Str.Tray.ShowHideSettings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding ChatOpeningCommand}"
                        Style="{StaticResource MenuItemDefaultStyle}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Translate" Width="16" Height="16" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Str.Tray.ShowHideTranslation}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator Style="{StaticResource SeparatorDefaultStyle}" />
                    <MenuItem
                        Command="{common:CloseAppCommand}"
                        CommandParameter="{StaticResource ConfirmationClose}"
                        Style="{StaticResource MenuItemDefaultStyle}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Power" Width="16" Height="16" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{DynamicResource Str.Tray.Exit}" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</UserControl>
