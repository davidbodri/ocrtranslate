<Window
    x:Class="Translumo.MVVM.Views.ChatWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:common="clr-namespace:Translumo.MVVM.Common"
    xmlns:controls="clr-namespace:Translumo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    Title="BDSTUDIO - Feliratok (OBS / Streamlabs)"
    Width="550"
    MinHeight="40"
    SizeToContent="Height"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Activated="Window_Activated"
    AllowsTransparency="True"
    BorderThickness="0"
    Background="Transparent"
    Deactivated="Window_Deactivated"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    Topmost="True"
    SourceInitialized="Window_SourceInitialized"
    Visibility="{Binding ChatWindowIsVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=TwoWay}"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <SolidColorBrush x:Key="brushFontColor" Color="{Binding Model.Configuration.FontColor}" />
        <common:BoldFontConverter x:Key="boldFontConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <controls:TrayControl
            ChatOpeningCommand="{Binding ShowHideChatCommand}"
            SettingsOpeningCommand="{Binding ShowHideSettingsCommand}"
            ObsSetupOpeningCommand="{Binding ToggleObsSetupModeCommand}" />

        <!-- Glossy Glass Container -->
        <Border
            x:Name="borderContainer"
            Margin="2"
            CornerRadius="8"
            ClipToBounds="True">
            <!-- 1. Outer Glass Edge (Light specular highlight at top, dark border at bottom) -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#66FFFFFF" />
                    <GradientStop Offset="0.3" Color="#25FFFFFF" />
                    <GradientStop Offset="0.7" Color="#10FFFFFF" />
                    <GradientStop Offset="1.0" Color="#40000000" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>

            <Grid>
                <!-- 2. Dark Glass / Smoke Background layer, bound directly to BackgroundOpacity and BackgroundColor -->
                <Border
                    x:Name="borderBackground"
                    CornerRadius="7"
                    Opacity="{Binding Model.Configuration.BackgroundOpacity}">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding Model.Configuration.BackgroundColor}" />
                    </Border.Background>
                </Border>

                <!-- 2b. Subtle vertical depth shading, also scaled with BackgroundOpacity -->
                <Border
                    x:Name="borderDepth"
                    CornerRadius="7"
                    IsHitTestVisible="False"
                    Opacity="{Binding Model.Configuration.BackgroundOpacity}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.0" Color="#25FFFFFF" />
                            <GradientStop Offset="0.4" Color="#00000000" />
                            <GradientStop Offset="1.0" Color="#45000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 3. Glossy Specular Reflection / Top Sheen -->
                <Border
                    VerticalAlignment="Top"
                    Height="24"
                    CornerRadius="7,7,0,0"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.0" Color="#35FFFFFF" />
                            <GradientStop Offset="0.4" Color="#12FFFFFF" />
                            <GradientStop Offset="1.0" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 4. Subtle Specular Highlight Line at the very top edge -->
                <Border
                    VerticalAlignment="Top"
                    Height="1"
                    Margin="6,0,6,0"
                    IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.25" Color="#50FFFFFF" />
                            <GradientStop Offset="0.5" Color="#85FFFFFF" />
                            <GradientStop Offset="0.75" Color="#50FFFFFF" />
                            <GradientStop Offset="1.0" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 5. Subtitle Text Box with drop shadow for supreme legibility -->
                <RichTextBox
                    x:Name="rtbChat"
                    Padding="12,8"
                    Background="#01000000"
                    BorderThickness="0"
                    Focusable="false"
                    FontSize="15"
                    IsReadOnly="True"
                    MouseDown="rtbChat_MouseDown">
                    <RichTextBox.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="315" Color="#E0000000" RenderingBias="Performance" />
                    </RichTextBox.Effect>
                    <FlowDocument />
                </RichTextBox>
            </Grid>
        </Border>

        <TextBlock
            Name="fontTextBlockInstance"
            LineHeight="{Binding Model.Configuration.LineSpacing}"
            TextAlignment="{Binding Model.Configuration.TextAlignment}"
            Visibility="Collapsed">
            <Run
                Name="fontRunInstance"
                FontSize="{Binding Model.Configuration.FontSize}"
                FontWeight="{Binding Model.Configuration.FontBold, Converter={StaticResource boldFontConverter}}"
                Foreground="{StaticResource brushFontColor}" />
            <Run
                Name="fontRunErrorInstance"
                FontSize="14"
                Foreground="{DynamicResource ErrorBrush}" />
            <Run
                Name="fontRunInfoInstance"
                FontSize="14"
                FontStyle="Italic"
                Foreground="{DynamicResource PrimaryHueMidBrush}" />
        </TextBlock>
    </Grid>
</Window>
