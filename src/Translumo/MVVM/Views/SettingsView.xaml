<Window
    x:Class="Translumo.MVVM.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Translumo.MVVM.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:viewModels="clr-namespace:Translumo.MVVM.ViewModels"
    xmlns:views="clr-namespace:Translumo.MVVM.Views"
    Name="wSettings"
    Title="{DynamicResource Str.Title.SettingWindow}"
    Width="960"
    Height="640"
    MinWidth="800"
    MinHeight="540"
    Activated="wSettings_Activated"
    Background="Transparent"
    AllowsTransparency="True"
    WindowStyle="None"
    Deactivated="wSettings_Deactivated"
    FontFamily="{DynamicResource MaterialDesignFont}"
    MouseDown="wSettings_MouseDown"
    ResizeMode="CanResizeWithGrip"
    SourceInitialized="wSettings_SourceInitialized"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:AppearanceSettingsViewModel}">
            <views:AppearanceSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HotkeysSettingsViewModel}">
            <views:HotkeysSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LanguagesSettingsViewModel}">
            <views:LanguagesSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OcrSettingsViewModel}">
            <views:OcrSettingsView />
        </DataTemplate>
        <common:CaseConverter x:Key="CaseConverter" Case="Upper" />
        <common:SliderPercentValueConverter x:Key="SliderPercentValueConverter" />
        <system:Boolean x:Key="ConfirmationClose">True</system:Boolean>
    </Window.Resources>

    <Border Background="{DynamicResource BdBackgroundBrush}"
            CornerRadius="22"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#18000000" RenderingBias="Performance" />
        </Border.Effect>

        <materialDesign:DialogHost CloseOnClickAway="{Binding DialogService.AllowCloseOnClickAway}" IsOpen="{Binding DialogService.IsOpen}">
            <materialDesign:DialogHost.DialogContent>
                <views:SimpleDialogView />
            </materialDesign:DialogHost.DialogContent>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left Navigation Rail -->
                    <ColumnDefinition Width="70" />
                    <!-- Main Bento Card Area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. LEFT MINIMALIST NAVIGATION RAIL -->
                <Border Grid.Column="0" Background="{DynamicResource BdBackgroundBrush}" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Brand Mark -->
                        <Border Grid.Row="0" Margin="0,16,0,16" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#000000" Cursor="Hand" MouseDown="wSettings_MouseDown">
                                <materialDesign:PackIcon Kind="LightningBolt" Width="20" Height="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>

                        <!-- Navigation Items -->
                        <ListBox Grid.Row="1"
                                 x:Name="NavListBox"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectionChanged="NavListBox_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalAlignment="Center"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,6" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="ItemPill"
                                                        Width="44"
                                                        Height="44"
                                                        CornerRadius="14"
                                                        Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemPill" Property="Background" Value="#E5E7EB" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemPill" Property="Background" Value="#FFFFFF" />
                                                        <Setter TargetName="ItemPill" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#15000000" RenderingBias="Performance" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Label}">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Foreground" Value="#71717A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="#000000" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Bottom Info Button -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Button Command="{Binding AboutDialogOpenedCommand}"
                                    Width="38"
                                    Height="38"
                                    Cursor="Hand"
                                    Style="{StaticResource RoundSecondaryButton}"
                                    ToolTip="Névjegy &amp; Rendszerinformáció">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#71717A" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. MAIN BENTO CARD -->
                <Border Grid.Column="1"
                        Margin="14,14,16,16"
                        CornerRadius="20"
                        Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="24,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#08000000" RenderingBias="Performance" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Clean Header & Controls -->
                            <RowDefinition Height="*" />    <!-- Content Area -->
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,14" MouseDown="wSettings_MouseDown" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Clean Title & Description -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="bdstudio"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#000000" />
                                    <TextBlock Text=" / ocrtranslate"
                                               FontSize="18"
                                               FontWeight="Normal"
                                               Foreground="#71717A" />
                                </StackPanel>
                                <TextBlock Text="Valós idejű képernyőfordítás és feliratozás"
                                           FontSize="11"
                                           Foreground="#A1A1AA"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Action Button + Window Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding AppearanceVm.SendTestTextCommand}"
                                        Cursor="Hand"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="32"
                                        Padding="14,0"
                                        Margin="0,0,12,0"
                                        Content="Teszt felirat"
                                        ToolTip="Teszt felirat megjelenítése a feliratablakban" />

                                <!-- Minimize Button -->
                                <Button Click="btnMinimize_Click"
                                        Width="30"
                                        Height="30"
                                        Cursor="Hand"
                                        Background="#F4F5F7"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Margin="0,0,6,0"
                                        ToolTip="Kis méret">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="15">
                                                <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Close Button -->
                                <Button Click="btnClose_Click"
                                        Width="30"
                                        Height="30"
                                        Cursor="Hand"
                                        Background="#F4F5F7"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        ToolTip="Bezárás">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="15">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Content Area -->
                        <Border Grid.Row="1" BorderBrush="#F0F1F3" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentControl Content="{Binding SelectedViewModel}" Margin="0,0,10,0" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:DialogHost>
    </Border>
</Window>
