<Window
    x:Class="Translumo.MVVM.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Translumo.MVVM.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:viewModels="clr-namespace:Translumo.MVVM.ViewModels"
    xmlns:views="clr-namespace:Translumo.MVVM.Views"
    Name="wSettings"
    Title="{DynamicResource Str.Title.SettingWindow}"
    Width="960"
    Height="640"
    MinWidth="800"
    MinHeight="540"
    Activated="wSettings_Activated"
    Background="Transparent"
    AllowsTransparency="True"
    WindowStyle="None"
    Deactivated="wSettings_Deactivated"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="CanResizeWithGrip"
    SourceInitialized="wSettings_SourceInitialized"
    TextElement.FontSize="13"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:AppearanceSettingsViewModel}">
            <views:AppearanceSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HotkeysSettingsViewModel}">
            <views:HotkeysSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LanguagesSettingsViewModel}">
            <views:LanguagesSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OcrSettingsViewModel}">
            <views:OcrSettingsView />
        </DataTemplate>
        <common:CaseConverter x:Key="CaseConverter" Case="Upper" />
        <common:SliderPercentValueConverter x:Key="SliderPercentValueConverter" />
        <system:Boolean x:Key="ConfirmationClose">True</system:Boolean>
    </Window.Resources>

    <Border Background="{DynamicResource BdBackgroundBrush}"
            CornerRadius="24"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            ClipToBounds="True"
            PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#18000000" RenderingBias="Performance" />
        </Border.Effect>

        <materialDesign:DialogHost CloseOnClickAway="{Binding DialogService.AllowCloseOnClickAway}" IsOpen="{Binding DialogService.IsOpen}">
            <materialDesign:DialogHost.DialogContent>
                <views:SimpleDialogView />
            </materialDesign:DialogHost.DialogContent>

            <Grid>
                <!-- MAIN WHITE BENTO CARD -->
                <Border Margin="14"
                        CornerRadius="20"
                        Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="24,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#08000000" RenderingBias="Performance" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Clean Header Row -->
                            <RowDefinition Height="*" />    <!-- Content Area with Bottom Padding for Dock -->
                        </Grid.RowDefinitions>

                        <!-- Top Header Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,14" MouseDown="wSettings_MouseDown" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Clean Title: BDSTUDIO. -->
                            <TextBlock Grid.Column="0"
                                       Text="BDSTUDIO."
                                       FontSize="22"
                                       FontWeight="Black"
                                       Foreground="#000000"
                                       VerticalAlignment="Center" />

                            <!-- Top Right Controls: Test Subtitle & Window Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding AppearanceVm.SendTestTextCommand}"
                                        Cursor="Hand"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="34"
                                        Padding="16,0"
                                        Margin="0,0,12,0"
                                        Content="Teszt felirat"
                                        ToolTip="Teszt felirat megjelenítése a képernyőn" />

                                <!-- Minimize Window Button -->
                                <Button Click="btnMinimize_Click"
                                        Width="30"
                                        Height="30"
                                        Cursor="Hand"
                                        Background="#F4F5F7"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Margin="0,0,6,0"
                                        ToolTip="Kis méret">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="15">
                                                <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Close Window Button -->
                                <Button Click="btnClose_Click"
                                        Width="30"
                                        Height="30"
                                        Cursor="Hand"
                                        Background="#F4F5F7"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        ToolTip="Bezárás">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="15">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Content Area (Scrollable with bottom padding so floating dock never overlaps) -->
                        <Border Grid.Row="1" BorderBrush="#F0F1F3" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,75">
                                <ContentControl Content="{Binding SelectedViewModel}" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- FLOATING BOTTOM CENTER DOCK MENU (Lebegő alsó menü - Fekete/Fehér) -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,26"
                        Background="#000000"
                        BorderBrush="#202022"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="6,5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#40000000" RenderingBias="Performance" />
                    </Border.Effect>

                    <ListBox x:Name="NavListBox"
                             ItemsSource="{Binding NavigationItems}"
                             SelectionChanged="NavListBox_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="3,0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="PillBorder"
                                                    CornerRadius="19"
                                                    Background="Transparent"
                                                    Padding="14,8"
                                                    SnapsToDevicePixels="True">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon x:Name="ItemIcon"
                                                                             Kind="{Binding Icon}"
                                                                             Width="19"
                                                                             Height="19"
                                                                             Foreground="#8E8E93"
                                                                             VerticalAlignment="Center" />
                                                    <TextBlock x:Name="ItemText"
                                                               Text="{Binding Label}"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="#000000"
                                                               Margin="8,0,2,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="Collapsed" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="PillBorder" Property="Background" Value="#222222" />
                                                    <Setter TargetName="ItemIcon" Property="Foreground" Value="#FFFFFF" />
                                                </MultiTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="#FFFFFF" />
                                                    <Setter TargetName="ItemIcon" Property="Foreground" Value="#000000" />
                                                    <Setter TargetName="ItemText" Property="Foreground" Value="#000000" />
                                                    <Setter TargetName="ItemText" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- ContentPresenter in template handles rendering -->
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </materialDesign:DialogHost>
    </Border>
</Window>
