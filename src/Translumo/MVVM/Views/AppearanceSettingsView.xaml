<UserControl
    x:Class="Translumo.MVVM.Views.AppearanceSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Translumo.MVVM.Common"
    xmlns:controls="clr-namespace:Translumo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="wControl"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="colorBrushWindow" Color="{Binding Model.BackgroundColor}" />
        <SolidColorBrush x:Key="colorBrushFont" Color="{Binding Model.FontColor}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <common:SliderPercentValueConverter x:Key="SliderPercentValueConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Left">
            <Grid.Resources>
                <Style TargetType="{x:Type StackPanel}">
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="56" />
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Orientation="Horizontal">
                <Button
                    Name="BtnWidowColor"
                    Background="{StaticResource colorBrushWindow}"
                    Click="btnWidowColor_Click"
                    Command="{Binding ChangeBackColorClickedCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    Style="{StaticResource RoundPrimaryButton}" />
                <Label Content="{DynamicResource Str.AppearanceSettings.WindowColor}" Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <Button
                    Name="BtnFontColor"
                    Background="{StaticResource colorBrushFont}"
                    Click="btnFontColor_Click"
                    Command="{Binding ChangeFontColorClickedCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    Style="{StaticResource RoundPrimaryButton}" />
                <Label Content="{DynamicResource Str.AppearanceSettings.FontColor}" Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Orientation="Horizontal">
                <controls:NumericInput
                    Maximum="80"
                    Minimum="1"
                    Value="{Binding Model.FontSize, Mode=TwoWay}" />
                <Label Content="{DynamicResource Str.AppearanceSettings.FontSize}" Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                Orientation="Horizontal">
                <controls:NumericInput
                    Maximum="50"
                    Minimum="1"
                    Value="{Binding Model.LineSpacing, Mode=TwoWay}" />
                <Label Content="{DynamicResource Str.AppearanceSettings.LineSpacing}" Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                Orientation="Horizontal">
                <ComboBox
                    Width="220"
                    DisplayMemberPath="DisplayText"
                    ItemsSource="{Binding Path=AvailableAlignments}"
                    SelectedValue="{Binding Path=Model.TextAlignment, Mode=TwoWay}"
                    SelectedValuePath="TextAlignment"
                    Style="{StaticResource ComboBoxBase}" />
            </StackPanel>
            <StackPanel
                Grid.Row="4"
                Grid.Column="0"
                Orientation="Horizontal">
                <ToggleButton IsChecked="{Binding Model.TextProcessing.AutoClearTexts}" Style="{StaticResource PrimaryToggleButton}" />
                <Label Content="{DynamicResource Str.AppearanceSettings.AutoClearTexts}" Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Vertical">
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <ToggleButton
                        x:Name="ExcludeFromCaptueToggle"
                        IsChecked="{Binding Model.ExcludeFromCaptue}"
                        Style="{StaticResource PrimaryToggleButton}" />
                    <Label Content="{DynamicResource Str.AppearanceSettings.ExcludeFromCaptue}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <ToggleButton
                        x:Name="BlurEnabledToggle"
                        IsChecked="{Binding Model.BlurEnabled}"
                        Style="{StaticResource PrimaryToggleButton}" />
                    <Label Content="{DynamicResource Str.AppearanceSettings.Blur}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <ToggleButton
                        x:Name="AutoHideEnabledToggle"
                        IsChecked="{Binding Model.AutoHideEnabled}"
                        Style="{StaticResource PrimaryToggleButton}" />
                    <Label Content="{DynamicResource Str.AppearanceSettings.AutoHide}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Visibility="{Binding Model.AutoHideEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:NumericInput
                        Width="84"
                        Maximum="10000"
                        Minimum="50"
                        Step="50"
                        Value="{Binding Model.IdleHideMs, Mode=TwoWay}" />
                    <Label Margin="8,0,0,0" Content="{DynamicResource Str.AppearanceSettings.IdleHideDelay}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Visibility="{Binding Model.AutoHideEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:NumericInput
                        Width="84"
                        Maximum="10000"
                        Minimum="50"
                        Step="50"
                        Value="{Binding Model.LineHoldMs, Mode=TwoWay}" />
                    <Label Margin="8,0,0,0" Content="{DynamicResource Str.AppearanceSettings.LineHoldDuration}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Visibility="{Binding Model.AutoHideEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:NumericInput
                        Width="84"
                        Maximum="10"
                        Minimum="1"
                        Step="1"
                        Value="{Binding Model.EmptyScansBeforeHide, Mode=TwoWay}" />
                    <Label Margin="8,0,0,0" Content="{DynamicResource Str.AppearanceSettings.EmptyScans}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Visibility="{Binding Model.AutoHideEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:NumericInput
                        Width="84"
                        Maximum="1000"
                        Minimum="0"
                        Step="50"
                        Value="{Binding Model.FadeOutMs, Mode=TwoWay}" />
                    <Label Margin="8,0,0,0" Content="{DynamicResource Str.AppearanceSettings.FadeOut}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Visibility="{Binding Model.AutoHideEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:NumericInput
                        Width="84"
                        Maximum="500"
                        Minimum="20"
                        Step="10"
                        Value="{Binding Model.WatchIntervalMs, Mode=TwoWay}" />
                    <Label Margin="8,0,0,0" Content="{DynamicResource Str.AppearanceSettings.WatcherInterval}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal" Visibility="{Binding Model.AutoHideEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ToggleButton
                        IsChecked="{Binding Model.ShowOriginalWhileTranslating}"
                        Style="{StaticResource PrimaryToggleButton}" />
                    <Label Content="{DynamicResource Str.AppearanceSettings.ShowOriginalWhileTranslating}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <Label Content="{DynamicResource Str.AppearanceSettings.WindowOpacity}" />
                <Slider
                    Name="slicderFontOpacity"
                    Width="220"
                    HorizontalAlignment="Left"
                    Style="{DynamicResource MaterialDesignSlider}"
                    Value="{Binding Model.BackgroundOpacity, Converter={StaticResource SliderPercentValueConverter}, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding SendTestTextCommand}"
                    Content="{DynamicResource Str.Button.ShowText}"
                    Style="{DynamicResource PrimaryButton}" />

                <!-- OBS / Streamlabs Live Streaming Section -->
                <Border Margin="0,24,0,10" Background="#F8F9FA" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="VideoOutline" Width="20" Height="20" Foreground="#000000" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Streamlabs / OBS Élő Közvetítés" FontWeight="Bold" FontSize="14" Foreground="#000000" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#4B5563" LineHeight="18" Margin="0,0,0,12">
                            A felirat Streamlabs-hez és OBS-hez adásához kapcsold be a beállító módot. Ilyenkor a doboz folyamatosan látható marad a képernyőn egy minta szöveggel, így kényelmesen elhelyezheted és méretezheted a közvetítéseden.
                            &#x0a;• Forrás típus: <Run FontWeight="SemiBold" Foreground="#111827">Ablakfelvétel (Window Capture)</Run>
                            &#x0a;• Kiválasztandó ablak: <Run FontWeight="SemiBold" Foreground="#111827">[ocrtranslate.exe]: BDSTUDIO - Feliratok (OBS / Streamlabs)</Run>
                            &#x0a;• Rögzítési mód (Capture Method): <Run FontWeight="SemiBold" Foreground="#111827">Windows 10 (1903 és újabb)</Run> (fontos az átlátszósághoz!)
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton IsChecked="{Binding IsObsSetupMode}" Style="{StaticResource PrimaryToggleButton}" Margin="0,0,10,0" />
                            <TextBlock Text="Streamlabs / OBS beállító mód (ablak zárolása minta szöveggel)" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#111827" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Orientation="Horizontal">
                <ToggleButton IsChecked="{Binding Model.FontBold}" Style="{StaticResource PrimaryToggleButton}" />
                <Label Content="{DynamicResource Str.AppearanceSettings.Bold}" Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel
                Grid.Row="4"
                Grid.Column="1"
                Orientation="Horizontal"
                Visibility="{Binding Model.TextProcessing.AutoClearTexts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Label
                    Margin="0,0,0,0"
                    Content="{DynamicResource Str.AppearanceSettings.AutoClearTexts2}"
                    Style="{StaticResource ControlCaptionLabel}" />
                <controls:NumericInput
                    Width="84"
                    Maximum="99999"
                    Minimum="1000"
                    Step="500"
                    Value="{Binding Model.TextProcessing.AutoClearTextsDelayMs, Mode=TwoWay}" />
                <Label
                    Margin="8,0,0,0"
                    Content="{DynamicResource Str.AppearanceSettings.Ms}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
        </Grid>
        <DockPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="9,0,0,0"
            Visibility="{Binding ColorPickerIsOpened, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:ColorSelectionControl
                x:Name="colorSelector"
                Padding="9,0,5,0"
                HorizontalAlignment="Stretch"
                BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                BorderThickness="1,0,0,0"
                ColorPickedCommand="{Binding ColorIsPickedCommand}"
                SelectedColor="{Binding SelectedColor, Mode=TwoWay}"
                UseLayoutRounding="False" />
        </DockPanel>
    </Grid>
</UserControl>
