<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignExtensions;component/Themes/MaterialDesignLightTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/materialdesigncolor.cyan.accent.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Fonts -->
    <FontFamily x:Key="MaterialDesignFont">Segoe UI Variable, Segoe UI, -apple-system, BlinkMacSystemFont, Arial, sans-serif</FontFamily>

    <!-- Modern Soft Bento Palette -->
    <Color x:Key="BdBackground">#EAECEF</Color>
    <Color x:Key="BdPanel">#FFFFFF</Color>
    <Color x:Key="BdPanelHover">#F7F8FA</Color>
    <Color x:Key="BdInput">#F2F4F7</Color>
    <Color x:Key="BdBorder">#E5E7EB</Color>
    <Color x:Key="BdTextPrimary">#0F1115</Color>
    <Color x:Key="BdTextSecondary">#6B7280</Color>
    <Color x:Key="BdTextDisabled">#9CA3AF</Color>

    <SolidColorBrush x:Key="BdBackgroundBrush" Color="{StaticResource BdBackground}" />
    <SolidColorBrush x:Key="BdPanelBrush" Color="{StaticResource BdPanel}" />
    <SolidColorBrush x:Key="BdPanelHoverBrush" Color="{StaticResource BdPanelHover}" />
    <SolidColorBrush x:Key="BdInputBrush" Color="{StaticResource BdInput}" />
    <SolidColorBrush x:Key="BdBorderBrush" Color="{StaticResource BdBorder}" />
    <SolidColorBrush x:Key="BdTextPrimaryBrush" Color="{StaticResource BdTextPrimary}" />
    <SolidColorBrush x:Key="BdTextSecondaryBrush" Color="{StaticResource BdTextSecondary}" />
    <SolidColorBrush x:Key="BdTextDisabledBrush" Color="{StaticResource BdTextDisabled}" />

    <!-- Material Design Theme Mapping -->
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="{StaticResource BdPanel}" />
    <SolidColorBrush x:Key="MaterialDesignBackground" Color="{StaticResource BdBackground}" />
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="{StaticResource BdPanel}" />
    <SolidColorBrush x:Key="MaterialDesignBody" Color="{StaticResource BdTextPrimary}" />
    <SolidColorBrush x:Key="MaterialDesignBodyLight" Color="{StaticResource BdTextSecondary}" />
    <SolidColorBrush x:Key="MaterialDesignDivider" Color="{StaticResource BdBorder}" />
    <SolidColorBrush x:Key="MaterialDesignTextFieldBoxBackground" Color="{StaticResource BdInput}" />
    <SolidColorBrush x:Key="MaterialDesignTextFieldBoxHoverBackground" Color="{StaticResource BdPanelHover}" />
    <SolidColorBrush x:Key="MaterialDesignFlatButtonClick" Color="#E5E7EB" />
    <SolidColorBrush x:Key="MaterialDesignFlatButtonRipple" Color="#D1D5DB" />

    <!-- Translumo Legacy Brush Mapping to Clean Bento Theme -->
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#F8F9FA" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="#0F1115" />

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="ChromeSelectionBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource BdPanelHover}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />

    <!-- Metrics -->
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="SurfaceCornerRadius">22</CornerRadius>

    <!-- Custom Modern Light Bento ScrollBar -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#CBD5E1" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="#D1D5DB" CornerRadius="3" Margin="0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="true">
                                                    <Setter Property="Background" Value="#9CA3AF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
