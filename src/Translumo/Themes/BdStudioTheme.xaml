<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignExtensions;component/Themes/MaterialDesignDarkTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/materialdesigncolor.cyan.accent.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Fonts -->
    <FontFamily x:Key="MaterialDesignFont">Segoe UI Variable, Segoe UI, Arial, sans-serif</FontFamily>

    <!-- Base Black-and-White Palette -->
    <Color x:Key="BdBackground">#0A0A0A</Color>
    <Color x:Key="BdPanel">#121212</Color>
    <Color x:Key="BdPanelHover">#1C1C1C</Color>
    <Color x:Key="BdInput">#181818</Color>
    <Color x:Key="BdBorder">#2A2A2A</Color>
    <Color x:Key="BdTextPrimary">#FFFFFF</Color>
    <Color x:Key="BdTextSecondary">#B3B3B3</Color>
    <Color x:Key="BdTextDisabled">#555555</Color>

    <SolidColorBrush x:Key="BdBackgroundBrush" Color="{StaticResource BdBackground}" />
    <SolidColorBrush x:Key="BdPanelBrush" Color="{StaticResource BdPanel}" />
    <SolidColorBrush x:Key="BdPanelHoverBrush" Color="{StaticResource BdPanelHover}" />
    <SolidColorBrush x:Key="BdInputBrush" Color="{StaticResource BdInput}" />
    <SolidColorBrush x:Key="BdBorderBrush" Color="{StaticResource BdBorder}" />
    <SolidColorBrush x:Key="BdTextPrimaryBrush" Color="{StaticResource BdTextPrimary}" />
    <SolidColorBrush x:Key="BdTextSecondaryBrush" Color="{StaticResource BdTextSecondary}" />
    <SolidColorBrush x:Key="BdTextDisabledBrush" Color="{StaticResource BdTextDisabled}" />

    <!-- Material Design Theme Mapping -->
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="{StaticResource BdPanel}" />
    <SolidColorBrush x:Key="MaterialDesignBackground" Color="{StaticResource BdBackground}" />
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="{StaticResource BdPanel}" />
    <SolidColorBrush x:Key="MaterialDesignBody" Color="{StaticResource BdTextPrimary}" />
    <SolidColorBrush x:Key="MaterialDesignBodyLight" Color="{StaticResource BdTextSecondary}" />
    <SolidColorBrush x:Key="MaterialDesignDivider" Color="{StaticResource BdBorder}" />
    <SolidColorBrush x:Key="MaterialDesignTextFieldBoxBackground" Color="{StaticResource BdInput}" />
    <SolidColorBrush x:Key="MaterialDesignTextFieldBoxHoverBackground" Color="{StaticResource BdPanelHover}" />
    <SolidColorBrush x:Key="MaterialDesignFlatButtonClick" Color="#333333" />
    <SolidColorBrush x:Key="MaterialDesignFlatButtonRipple" Color="#444444" />

    <!-- Translumo Legacy Brush Mapping to Black-and-White Theme -->
    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#0A0A0A" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="{StaticResource BdBackground}" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#181818" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChromeSelectionBrush" Color="#222222" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource BdPanelHover}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E53935" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B3B3B3" />

    <!-- Metrics -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="SurfaceCornerRadius">8</CornerRadius>

    <!-- Custom Modern Dark ScrollBar -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="#333333" CornerRadius="4" Margin="1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="true">
                                                    <Setter Property="Background" Value="#555555" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
